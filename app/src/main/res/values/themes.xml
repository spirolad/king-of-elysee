<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        The game ships a single light look, hence a Light parent and no values-night override.
        Bridges the King of Élysée tokens to Material 3 so stock components render with the
        game palette (mirror of KoeMaterialMapping.kt).
    -->
    <style name="Base.Theme.KingOfElysee" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/koe_action_primary_container</item>
        <item name="colorOnPrimary">@color/koe_action_primary_content</item>
        <item name="colorSecondary">@color/koe_action_validate_container</item>
        <item name="colorOnSecondary">@color/koe_action_validate_content</item>
        <item name="colorTertiary">@color/koe_resource_mechancete_container</item>
        <item name="colorOnTertiary">@color/koe_resource_mechancete_content</item>
        <item name="android:colorBackground">@color/koe_screen_board_container</item>
        <item name="colorOnBackground">@color/koe_screen_board_content</item>
        <item name="colorSurface">@color/koe_surface</item>
        <item name="colorOnSurface">@color/koe_text_primary</item>
        <item name="colorSurfaceVariant">@color/koe_surface_sunken</item>
        <item name="colorOnSurfaceVariant">@color/koe_text_muted</item>
        <item name="colorOutline">@color/koe_action_outline</item>
        <item name="colorOutlineVariant">@color/koe_surface_line</item>
        <item name="colorError">@color/koe_text_danger</item>
        <item name="colorOnError">@color/koe_text_on_dark</item>
        <item name="colorErrorContainer">@color/koe_status_danger_container</item>
        <item name="colorOnErrorContainer">@color/koe_status_danger_content</item>
        <!--
            Default font goes through the TextView style, not android:fontFamily: a theme-level
            fontFamily outranks every textAppearance and would hide Anton on the display styles.
        -->
        <item name="android:textViewStyle">@style/Widget.Koe.TextView</item>
    </style>

    <style name="Theme.KingOfElysee" parent="Base.Theme.KingOfElysee" />

    <!-- Dialogs float over the match: transparent window, dimmed scrim, fade transitions. -->
    <!--
        Plain overlay, not ThemeOverlay.Material3.Dialog: that one brings AppCompat dialog
        defaults and a flush text button style that grey out the Koe white buttons.
    -->
    <style name="ThemeOverlay.Koe.Dialog" parent="ThemeOverlay.Material3">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowAnimationStyle">@style/Animation.Koe.Dialog</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
    </style>

    <!-- Evil (Mechancete) dialogs darken the scrim further. -->
    <style name="ThemeOverlay.Koe.Dialog.Evil" parent="ThemeOverlay.Koe.Dialog">
        <item name="android:backgroundDimAmount">0.7</item>
    </style>

    <style name="Animation.Koe.Dialog" parent="">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>
</resources>
