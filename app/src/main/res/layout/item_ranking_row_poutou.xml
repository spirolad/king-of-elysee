<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/koe_space_xs"
    android:paddingBottom="@dimen/koe_space_xs">

    <View
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_roll_dot"
        android:backgroundTint="@color/koe_candidate_poutou_container" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/koe_space_s"
        android:layout_weight="1"
        android:text="@string/character_poutou_name"
        android:textAppearance="@style/TextAppearance.Koe.Title"
        android:textColor="@color/koe_text_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mock_rank_votes_poutou"
        android:textAppearance="@style/TextAppearance.Koe.Stat"
        android:textColor="@color/koe_resource_votes_container" />

    <ImageView
        android:layout_width="@dimen/koe_icon_m"
        android:layout_height="@dimen/koe_icon_m"
        android:layout_marginStart="@dimen/koe_space_xs"
        android:contentDescription="@null"
        android:src="@drawable/ic_vote"
        app:tint="@color/koe_resource_votes_container" />

</LinearLayout>
