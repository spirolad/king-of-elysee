<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_vote"
        app:tint="@color/koe_resource_votes_container" />

    <TextView
        android:layout_width="16dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/koe_space_xs"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/mock_me_votes"
        android:textAppearance="@style/TextAppearance.Koe.StatBig"
        android:textColor="@color/koe_resource_votes_container"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/koe_space_xs"
        android:text="@string/stat_votes_max"
        android:textAppearance="@style/TextAppearance.Koe.Name"
        android:textColor="@color/koe_text_muted"
        android:textSize="12sp" />

</LinearLayout>
