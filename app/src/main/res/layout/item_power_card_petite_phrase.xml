<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/koe_card_width"
    android:layout_height="@dimen/koe_card_height"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/koe_card_header_height">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.18"
            android:background="@drawable/bg_card_header"
            android:backgroundTint="@color/koe_resource_mechancete_container" />

        <ImageView
            android:layout_width="@dimen/koe_icon_l"
            android:layout_height="@dimen/koe_icon_l"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_mechancete"
            app:tint="@color/koe_resource_mechancete_container" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingTop="8dp"
        android:paddingEnd="13dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/mock_card_petite_phrase_title"
            android:textAppearance="@style/TextAppearance.Koe.CardTitle"
            android:textColor="@color/koe_text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/koe_space_xs"
            android:gravity="center_horizontal"
            android:text="@string/mock_card_petite_phrase_desc"
            android:textAppearance="@style/TextAppearance.Koe.CardDescription"
            android:textColor="@color/koe_text_muted" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            style="@style/Widget.Koe.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:backgroundTint="@color/koe_resource_mechancete_container"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="3dp"
            android:text="@string/card_type_mechancete"
            android:textColor="@color/koe_resource_mechancete_content"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>
