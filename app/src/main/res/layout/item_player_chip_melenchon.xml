<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_chip_player"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minWidth="220dp"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="6dp"
    android:paddingEnd="@dimen/koe_space_l"
    android:paddingBottom="6dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@color/koe_candidate_melenchon_container"
        android:contentDescription="@string/cd_avatar"
        android:scaleType="centerCrop"
        android:src="@drawable/melanchon"
        app:shapeAppearanceOverlay="@style/CircleShapeAppearance" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/koe_space_xs"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/character_melenchon_name"
            android:textAppearance="@style/TextAppearance.Koe.Name"
            android:lineHeight="20sp"
            android:textColor="@color/koe_text_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_popularite"
                app:tint="@color/koe_resource_popularite_container" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="@string/mock_chip_melenchon_popularite"
                android:textAppearance="@style/TextAppearance.Koe.Stat"
                android:textSize="15sp"
                android:textColor="@color/koe_resource_popularite_container" />

            <Space
                android:layout_width="11dp"
                android:layout_height="wrap_content" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_vote"
                app:tint="@color/koe_resource_votes_container" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="@string/mock_chip_melenchon_votes"
                android:textAppearance="@style/TextAppearance.Koe.Stat"
                android:textSize="15sp"
                android:textColor="@color/koe_resource_votes_container" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
