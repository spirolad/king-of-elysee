<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="28dp"
        android:paddingTop="33dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialog"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/koe_space_l"
            android:paddingTop="28dp"
            android:paddingEnd="@dimen/koe_space_l"
            android:paddingBottom="@dimen/koe_space_l">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quit_title"
                android:textAppearance="@style/TextAppearance.Koe.H1"
                android:textColor="@color/koe_text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/koe_space_s"
                android:gravity="center"
                android:text="@string/mock_quit_message"
                android:textAppearance="@style/TextAppearance.Koe.Body"
                android:textColor="@color/koe_text_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel"
                    style="@style/Widget.Koe.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:minHeight="52dp"
                    android:text="@string/btn_cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_quit"
                    style="@style/Widget.Koe.Button.Danger"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/koe_space_s"
                    android:layout_weight="1"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:minHeight="52dp"
                    android:text="@string/btn_quit"
                    android:textColor="@color/koe_action_primary_content"
                    app:backgroundTint="@color/koe_text_danger" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="top|start"
            android:contentDescription="@null"
            android:rotation="-12"
            android:src="@drawable/ic_bonnet"
            android:tint="@color/koe_status_danger_container" />
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
