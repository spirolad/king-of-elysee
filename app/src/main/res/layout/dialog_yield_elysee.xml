<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog"
        android:orientation="vertical"
        android:padding="@dimen/koe_space_l">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@color/koe_candidate_lepen_container"
                    android:contentDescription="@string/cd_avatar"
                    android:scaleType="centerCrop"
                    android:src="@drawable/lepen"
                    app:shapeAppearance="@style/CircleShapeAppearance"
                    app:strokeColor="@color/koe_status_warning_container"
                    app:strokeWidth="@dimen/koe_outline_thick" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="47dp"
                    android:layout_marginTop="-15dp"
                    android:contentDescription="@null"
                    android:rotation="14"
                    android:src="@drawable/ic_crown"
                    android:tint="@color/koe_status_warning_container" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="23dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_dark"
                    android:paddingStart="@dimen/koe_space_xs"
                    android:paddingTop="3dp"
                    android:paddingEnd="@dimen/koe_space_xs"
                    android:paddingBottom="3dp"
                    android:text="@string/mock_yield_pass_phone"
                    android:textAppearance="@style/TextAppearance.Koe.Caption"
                    android:textColor="@color/koe_text_on_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/koe_space_m"
                    android:text="@string/yield_title"
                    android:textAppearance="@style/TextAppearance.Koe.H1"
                    android:textColor="@color/koe_text_primary"
                    android:textSize="30sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/koe_space_xl"
            android:background="@drawable/bg_inset"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/koe_space_m"
            android:paddingTop="15dp"
            android:paddingEnd="@dimen/koe_space_m"
            android:paddingBottom="15dp">

            <ImageView
                android:layout_width="@dimen/koe_icon_m"
                android:layout_height="@dimen/koe_icon_m"
                android:contentDescription="@null"
                android:src="@drawable/ic_tweet"
                android:tint="@color/koe_resource_tweet_container" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/mock_yield_tweet_notice"
                android:textAppearance="@style/TextAppearance.Koe.Body"
                android:textColor="@color/koe_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/koe_space_xs"
                android:text="@string/mock_yield_damage"
                android:textAppearance="@style/TextAppearance.Koe.Stat"
                android:textColor="@color/koe_text_danger"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mock_yield_remaining"
                android:textAppearance="@style/TextAppearance.Koe.Body"
                android:textColor="@color/koe_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/koe_space_l"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_stay"
                    style="@style/Widget.Koe.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:minHeight="52dp"
                    android:text="@string/btn_stay" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/koe_space_xs"
                    android:gravity="center"
                    android:text="@string/yield_stay_hint"
                    android:textAppearance="@style/TextAppearance.Koe.BodySmall"
                    android:textColor="@color/koe_text_muted" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/koe_space_s"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_yield"
                    style="@style/Widget.Koe.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:minHeight="52dp"
                    android:text="@string/btn_yield" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/koe_space_xs"
                    android:gravity="center"
                    android:text="@string/mock_yield_cede_hint"
                    android:textAppearance="@style/TextAppearance.Koe.BodySmall"
                    android:textColor="@color/koe_text_muted" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
