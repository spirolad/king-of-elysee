<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="@dimen/koe_space_l">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pause_title"
                android:textAppearance="@style/TextAppearance.Koe.H1"
                android:textColor="@color/koe_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/koe_space_l"
                android:text="@string/mock_pause_turn"
                android:textAppearance="@style/TextAppearance.Koe.Body"
                android:textColor="@color/koe_text_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/koe_space_s"
                android:background="@drawable/bg_inset"
                android:orientation="vertical"
                android:padding="@dimen/koe_space_s">

                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/item_ranking_row_lepen" />

                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/item_ranking_row_macron" />

                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/item_ranking_row_melenchon" />

                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/item_ranking_row_poutou" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="210dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/koe_space_l"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_resume"
                style="@style/Widget.Koe.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="52dp"
                android:text="@string/btn_resume"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/koe_action_primary_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_rules"
                style="@style/Widget.Koe.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/koe_space_s"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="52dp"
                android:text="@string/btn_rules" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_settings"
                style="@style/Widget.Koe.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/koe_space_s"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="52dp"
                android:text="@string/btn_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quit"
                style="@style/Widget.Koe.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/koe_space_s"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="52dp"
                android:text="@string/btn_quit"
                android:textColor="@color/koe_action_primary_content"
                app:backgroundTint="@color/koe_text_danger"
                app:icon="@drawable/ic_logout"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/koe_action_primary_content" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
