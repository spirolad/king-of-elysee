<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="32dp"
        android:paddingTop="34dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialog_evil"
            android:orientation="vertical"
            android:paddingStart="@dimen/koe_space_l"
            android:paddingTop="20dp"
            android:paddingEnd="@dimen/koe_space_l"
            android:paddingBottom="@dimen/koe_space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="72dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mechancete_title"
                        android:textAppearance="@style/TextAppearance.Koe.H1"
                        android:textColor="@color/koe_screen_evil_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mock_mechancete_reached"
                        android:textAppearance="@style/TextAppearance.Koe.Body"
                        android:textColor="@color/koe_screen_evil_content" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_validate"
                    style="@style/Widget.Koe.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/koe_space_s"
                    android:enabled="false"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:minWidth="125dp"
                    android:minHeight="52dp"
                    android:text="@string/btn_validate"
                    android:textColor="@color/koe_text_primary"
                    app:backgroundTint="@color/koe_text_disabled" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="474dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <include
                    android:layout_width="0dp"
                    android:layout_height="@dimen/koe_card_height"
                    android:layout_marginEnd="@dimen/koe_space_s"
                    android:layout_weight="1"
                    layout="@layout/item_power_card_petite_phrase" />

                <include
                    android:layout_width="0dp"
                    android:layout_height="@dimen/koe_card_height"
                    android:layout_marginEnd="@dimen/koe_space_s"
                    android:layout_weight="1"
                    layout="@layout/item_power_card_petite_phrase" />

                <include
                    android:layout_width="0dp"
                    android:layout_height="@dimen/koe_card_height"
                    android:layout_weight="1"
                    layout="@layout/item_power_card_petite_phrase" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="top|start"
            android:background="@drawable/bg_badge_count"
            android:backgroundTint="@color/koe_resource_mechancete_container"
            android:rotation="-14">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_mechancete"
                android:tint="@color/koe_resource_mechancete_content" />
        </FrameLayout>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
