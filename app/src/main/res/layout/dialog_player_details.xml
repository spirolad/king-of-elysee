<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <!-- Left column: portrait, name, badge, number -->
        <LinearLayout
            android:layout_width="148dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:layout_marginTop="4dp"
                android:clipChildren="false">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/koe_candidate_melenchon_container"
                    android:contentDescription="@string/cd_avatar"
                    android:scaleType="centerCrop"
                    android:src="@drawable/melanchon"
                    app:shapeAppearance="@style/CircleShapeAppearance"
                    app:strokeColor="@color/koe_status_warning_container"
                    app:strokeWidth="@dimen/koe_outline_thick" />

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-16dp"
                    android:layout_marginEnd="-1dp"
                    android:contentDescription="@null"
                    android:rotation="14"
                    android:src="@drawable/ic_crown"
                    app:tint="@color/koe_status_warning_container" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/mock_player_details_name"
                android:textAppearance="@style/TextAppearance.Koe.H2"
                android:textColor="@color/koe_text_primary" />

            <TextView
                style="@style/Widget.Koe.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/match_badge_in_power" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/mock_player_details_number"
                android:textAppearance="@style/TextAppearance.Koe.BodySmall"
                android:textColor="@color/koe_text_muted" />

        </LinearLayout>

        <!-- Right column: stats row, title and cards -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_inset"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp">

                    <!-- a) Popularite -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/koe_icon_s"
                                android:layout_height="@dimen/koe_icon_s"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_popularite"
                                app:tint="@color/koe_resource_popularite_container" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="@string/mock_player_details_popularite"
                                android:textAppearance="@style/TextAppearance.Koe.StatBig"
                                android:textColor="@color/koe_resource_popularite_container" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="@string/stat_popularite_max"
                                android:textAppearance="@style/TextAppearance.Koe.BodySmall"
                                android:textColor="@color/koe_text_muted" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="16dp"
                                android:layout_height="@dimen/koe_segment_height"
                                android:layout_marginEnd="3dp"
                                android:background="@drawable/bg_meter_segment_on"
                                android:backgroundTint="@color/koe_resource_popularite_container" />

                            <View
                                android:layout_width="16dp"
                                android:layout_height="@dimen/koe_segment_height"
                                android:layout_marginEnd="3dp"
                                android:background="@drawable/bg_meter_segment_on"
                                android:backgroundTint="@color/koe_resource_popularite_container" />

                            <View
                                android:layout_width="16dp"
                                android:layout_height="@dimen/koe_segment_height"
                                android:layout_marginEnd="3dp"
                                android:background="@drawable/bg_meter_segment_on"
                                android:backgroundTint="@color/koe_resource_popularite_container" />

                            <View
                                android:layout_width="16dp"
                                android:layout_height="@dimen/koe_segment_height"
                                android:layout_marginEnd="3dp"
                                android:background="@drawable/bg_meter_segment_on"
                                android:backgroundTint="@color/koe_resource_popularite_container" />

                            <View
                                android:layout_width="16dp"
                                android:layout_height="@dimen/koe_segment_height"
                                android:layout_marginEnd="3dp"
                                android:background="@drawable/bg_meter_segment_on"
                                android:backgroundTint="@color/koe_resource_popularite_container" />

                            <View
                                android:layout_width="16dp"
                                android:layout_height="@dimen/koe_segment_height"
                                android:layout_marginEnd="3dp"
                                android:background="@drawable/bg_meter_segment_on"
                                android:backgroundTint="@color/koe_resource_popularite_container" />

                            <View
                                android:layout_width="16dp"
                                android:layout_height="@dimen/koe_segment_height"
                                android:layout_marginEnd="3dp"
                                android:alpha="0.3"
                                android:background="@drawable/bg_meter_segment_on"
                                android:backgroundTint="@color/koe_resource_popularite_container" />

                            <View
                                android:layout_width="16dp"
                                android:layout_height="@dimen/koe_segment_height"
                                android:layout_marginEnd="3dp"
                                android:alpha="0.3"
                                android:background="@drawable/bg_meter_segment_on"
                                android:backgroundTint="@color/koe_resource_popularite_container" />

                            <View
                                android:layout_width="16dp"
                                android:layout_height="@dimen/koe_segment_height"
                                android:layout_marginEnd="3dp"
                                android:alpha="0.3"
                                android:background="@drawable/bg_meter_segment_on"
                                android:backgroundTint="@color/koe_resource_popularite_container" />

                            <View
                                android:layout_width="16dp"
                                android:layout_height="@dimen/koe_segment_height"
                                android:alpha="0.3"
                                android:background="@drawable/bg_meter_segment_on"
                                android:backgroundTint="@color/koe_resource_popularite_container" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- b) Votes -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/koe_icon_s"
                                android:layout_height="@dimen/koe_icon_s"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_vote"
                                app:tint="@color/koe_resource_votes_container" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="@string/mock_player_details_votes"
                                android:textAppearance="@style/TextAppearance.Koe.StatBig"
                                android:textColor="@color/koe_resource_votes_container" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="@string/stat_votes_max"
                                android:textAppearance="@style/TextAppearance.Koe.BodySmall"
                                android:textColor="@color/koe_text_muted" />

                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:layout_width="176dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:max="20"
                            android:progress="17"
                            app:indicatorColor="@color/koe_resource_votes_container"
                            app:trackColor="@color/koe_surface_line"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />

                    </LinearLayout>

                    <!-- c) Fonds and Mechancete -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/koe_icon_m"
                                android:layout_height="@dimen/koe_icon_m"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_fonds"
                                app:tint="@color/koe_resource_fonds_publics_container" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/mock_player_details_fonds"
                                android:textAppearance="@style/TextAppearance.Koe.Stat"
                                android:textColor="@color/koe_text_warning" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/stat_fonds"
                                android:textAppearance="@style/TextAppearance.Koe.BodySmall"
                                android:textColor="@color/koe_text_muted" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/koe_icon_m"
                                android:layout_height="@dimen/koe_icon_m"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_mechancete"
                                app:tint="@color/koe_resource_mechancete_container" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/mock_player_details_mechancete"
                                android:textAppearance="@style/TextAppearance.Koe.Stat"
                                android:textColor="@color/koe_resource_mechancete_container" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/stat_mechancete"
                                android:textAppearance="@style/TextAppearance.Koe.BodySmall"
                                android:textColor="@color/koe_text_muted" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_close"
                    style="@style/Widget.Koe.IconButton.Outline"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="13dp"
                    android:contentDescription="@string/cd_close"
                    app:icon="@drawable/ic_close"
                    app:iconSize="20dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/player_details_cards"
                android:textAppearance="@style/TextAppearance.Koe.Title"
                android:textColor="@color/koe_text_primary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <include
                    android:layout_width="@dimen/koe_card_width"
                    android:layout_height="@dimen/koe_card_height"
                    android:layout_marginEnd="8dp"
                    layout="@layout/item_power_card_meeting_owned" />

                <include
                    android:layout_width="@dimen/koe_card_width"
                    android:layout_height="@dimen/koe_card_height"
                    android:layout_marginEnd="8dp"
                    layout="@layout/item_power_card_meeting_owned" />

                <include
                    android:layout_width="@dimen/koe_card_width"
                    android:layout_height="@dimen/koe_card_height"
                    layout="@layout/item_power_card_petite_phrase" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
