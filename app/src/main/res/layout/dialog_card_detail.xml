<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:clipChildren="false"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingTop="31dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <!-- Left: rotated card -->
        <FrameLayout
            android:layout_width="218dp"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:paddingStart="21dp">

            <FrameLayout
                android:layout_width="197dp"
                android:layout_height="232dp"
                android:layout_gravity="start|top"
                android:rotation="-15">

                <include
                    android:layout_width="@dimen/koe_card_width"
                    android:layout_height="@dimen/koe_card_height"
                    android:layout_gravity="center"
                    layout="@layout/item_power_card_meeting" />

            </FrameLayout>

        </FrameLayout>

        <!-- Right: details -->
        <LinearLayout
            android:layout_width="370dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Koe.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_detail_badge_pouvoir"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/mock_card_cumul_title"
                android:textAppearance="@style/TextAppearance.Koe.H1"
                android:textColor="@color/koe_text_primary" />

            <TextView
                android:layout_width="330dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/mock_card_cumul_desc"
                android:textAppearance="@style/TextAppearance.Koe.Body"
                android:textColor="@color/koe_text_primary" />

            <LinearLayout
                android:layout_width="330dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_inset"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/koe_icon_s"
                        android:layout_height="@dimen/koe_icon_s"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_fonds"
                        app:tint="@color/koe_resource_fonds_publics_container" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/mock_card_detail_paid"
                        android:textAppearance="@style/TextAppearance.Koe.BodySmall"
                        android:textColor="@color/koe_text_primary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/koe_icon_s"
                        android:layout_height="@dimen/koe_icon_s"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_clock"
                        app:tint="@color/koe_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/card_detail_permanent"
                        android:textAppearance="@style/TextAppearance.Koe.BodySmall"
                        android:textColor="@color/koe_text_primary" />

                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ok"
                style="@style/Widget.Koe.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="0dp"
                android:minWidth="81dp"
                android:text="@string/btn_ok" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
