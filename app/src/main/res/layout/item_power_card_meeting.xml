<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/koe_card_width"
    android:layout_height="@dimen/koe_card_height"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/koe_card_header_height">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.18"
            android:background="@drawable/bg_card_header"
            android:backgroundTint="@color/koe_status_warning_container" />

        <ImageView
            android:layout_width="@dimen/koe_icon_l"
            android:layout_height="@dimen/koe_icon_l"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_star"
            app:tint="@color/koe_status_warning_container" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="3dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp">

            <ImageView
                android:layout_width="@dimen/koe_icon_s"
                android:layout_height="@dimen/koe_icon_s"
                android:contentDescription="@null"
                android:src="@drawable/ic_fonds"
                app:tint="@color/koe_resource_fonds_publics_container" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="@string/mock_card_meeting_cost"
                android:textAppearance="@style/TextAppearance.Koe.Stat"
                android:textColor="@color/koe_text_primary"
                android:textSize="15sp" />

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingTop="8dp"
        android:paddingEnd="13dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/mock_card_meeting_title"
            android:textAppearance="@style/TextAppearance.Koe.CardTitle"
            android:textColor="@color/koe_text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/koe_space_xs"
            android:gravity="center_horizontal"
            android:text="@string/mock_card_meeting_desc"
            android:textAppearance="@style/TextAppearance.Koe.CardDescription"
            android:textColor="@color/koe_text_muted" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            style="@style/Widget.Koe.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:backgroundTint="@color/koe_status_warning_container"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="3dp"
            android:text="@string/card_type_pouvoir"
            android:textColor="@color/koe_status_warning_content"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>
